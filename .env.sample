# Only secrets belong in this file. Everything else is in kirak.json: the database
# host, name and user (database), the public URL (base_url), the app name
# (project_name), CORS origins (cors.origins) and social login client IDs
# (auth.social). Kirak Studio's own origin is added at deploy time so the
# in-Studio playground keeps working.

# -- Database password (required) ----------------------------------------------
DB_PASSWORD=

# -- Auth (required) -----------------------------------------------------------
KIRAK_AUTH_JWT_SECRET_KEY=
KIRAK_AUTH_JWT_REFRESH_SECRET_KEY=
KIRAK_AUTH_VERIFICATION_KEY=

# -- Auth advanced (optional) ---------------------------------------------------
# KIRAK_AUTH_ENCRYPTION_KEYS=  # comma-separated base64 keys of 32 bytes; encrypts stored secrets (MFA, social, integrations)
# KIRAK_AUTH_API_KEY_SECRET=  # hashes API keys; falls back to KIRAK_AUTH_JWT_SECRET_KEY
# KIRAK_AUTH_JWT_OLD_SECRET_KEY=  # set only during a JWT secret rotation window
# KIRAK_AUTH_JWT_REFRESH_OLD_SECRET_KEY=

# -- Redis (optional: enables Redis-backed rate limiting, token blacklist, OTP cache) -
# KIRAK_REDIS_URL=

# -- Notifications (optional) --------------------------------------------------
# Providers are declared in kirak.json (notifications.email / .sms / .push), each
# with a default instance name. The instance name is part of the variable name:
#   KIRAK_NOTIFICATION_<CHANNEL>_<INSTANCE>_<FIELD>
# Sender address, region, host and port are kirak.json settings, not variables.
#
# AWS SES (email instance "ses")
# KIRAK_NOTIFICATION_EMAIL_SES_ACCESS_KEY=
# KIRAK_NOTIFICATION_EMAIL_SES_SECRET_KEY=
#
# AWS SNS (sms instance "sns")
# KIRAK_NOTIFICATION_SMS_SNS_ACCESS_KEY=
# KIRAK_NOTIFICATION_SMS_SNS_SECRET_KEY=
#
# SendGrid (email instance "sendgrid")
# KIRAK_NOTIFICATION_EMAIL_SENDGRID_API_KEY=
#
# SMTP (email instance "smtp")
# KIRAK_NOTIFICATION_EMAIL_SMTP_USERNAME=
# KIRAK_NOTIFICATION_EMAIL_SMTP_PASSWORD=
#
# Firebase push has no variables: set firebase_credentials_path and
# firebase_project_id on the "firebase" instance in kirak.json.

# -- Payments (optional) -------------------------------------------------------
# Stripe
# KIRAK_PAYMENT_STRIPE_SECRET_KEY=
# KIRAK_PAYMENT_STRIPE_PUBLISHABLE_KEY=
# KIRAK_PAYMENT_STRIPE_WEBHOOK_SECRET=
# Stripe Connect (its own instance "stripe_connect"; only if using Connect)
# KIRAK_PAYMENT_STRIPE_CONNECT_SECRET_KEY=
# KIRAK_PAYMENT_STRIPE_CONNECT_WEBHOOK_SECRET=
#
# Razorpay
# KIRAK_PAYMENT_RAZORPAY_KEY_ID=
# KIRAK_PAYMENT_RAZORPAY_KEY_SECRET=
# KIRAK_PAYMENT_RAZORPAY_WEBHOOK_SECRET=
#
# Square (location_id and environment are kirak.json settings on the "square" instance)
# KIRAK_PAYMENT_SQUARE_ACCESS_TOKEN=
# KIRAK_PAYMENT_SQUARE_WEBHOOK_SIGNATURE_KEY=

# -- AI module (optional) ------------------------------------------------------
# Models are "provider:model" strings in kirak.json (ai.default_model) and in each
# agent file. The provider SDK reads its own API key variable.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# -- Vector (required only if the 'vector' module is enabled) -------------------
# Stores and embedding providers are declared in kirak.json (vector.store,
# vector.embedding). One set of secrets per instance:
# KIRAK_VECTOR_STORE_<INSTANCE>_<FIELD> and KIRAK_VECTOR_EMBEDDING_<INSTANCE>_<FIELD>.
#
# Pinecone (instance "pinecone")
# KIRAK_VECTOR_STORE_PINECONE_API_KEY=
#
# Amazon S3 Vectors (requires: pip install kirak[vector-s3vectors]; instance "s3v").
# Bucket and region are kirak.json settings. Leave the keys unset to use boto3's
# default credential chain (IAM role, ~/.aws/credentials).
# KIRAK_VECTOR_STORE_S3V_ACCESS_KEY_ID=
# KIRAK_VECTOR_STORE_S3V_SECRET_ACCESS_KEY=
#
# Embeddings (Ollama needs no key)
# KIRAK_VECTOR_EMBEDDING_OPENAI_API_KEY=
# KIRAK_VECTOR_EMBEDDING_GOOGLE_API_KEY=

# -- Monitoring (required only if the 'monitoring' module is enabled) ----------
# Bearer token every /monitoring/* endpoint requires (except /monitoring/ping) --
# this is what Kirak Studio's own Monitoring tab authenticates with.
# KIRAK_MONITORING_INGESTION_KEY=

# -- Storage (optional) --------------------------------------------------------
# Providers are declared in kirak.json (storage.providers); bucket, region and upload
# directory are settings there. Credentials for an instance named "aws" or "wasabi":
# KIRAK_STORAGE_AWS_ACCESS_KEY=
# KIRAK_STORAGE_AWS_SECRET_KEY=

# -- OAuth Social Login (optional) --------------------------------------------
# Declare providers in kirak.json under auth.social_providers using catalog names.
# Top providers: google-oauth2, github, apple-id, facebook, instagram, tiktok,
#   linkedin-oauth2, discord, twitter-oauth2, microsoft-graph
# Full catalog: call lookup_social_provider in the AI to check any other provider.
# Client IDs and redirect URIs are kirak.json settings (auth.social.<provider>);
# only the secrets go here.
# SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
# SOCIAL_AUTH_GITHUB_SECRET=
# SOCIAL_AUTH_INSTAGRAM_SECRET=
# SOCIAL_AUTH_TIKTOK_SECRET=
# SOCIAL_AUTH_APPLE_ID_SECRET=  # the Apple private key (.p8 contents)

# -- Scheduler (optional: only for providers other than the database) ----------
# Providers, poll interval, concurrency and retries are kirak.json settings. Redis and
# RabbitMQ instances read one URL each: KIRAK_SCHEDULER_<INSTANCE>_URL
#
# Redis (requires: pip install kirak[scheduler-redis]; instance "redis")
# KIRAK_SCHEDULER_REDIS_URL=
#
# RabbitMQ (requires: pip install kirak[scheduler-rabbitmq]; instance "rabbitmq")
# KIRAK_SCHEDULER_RABBITMQ_URL=
